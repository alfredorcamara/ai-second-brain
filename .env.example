# ============================================
# AI SECOND BRAIN — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/Mac)
#
# ⚠️  O arquivo .env está listado no .gitignore
# e NUNCA deve ser commitado no Git.
# ============================================

# Groq API — Motor de IA para o Research Lab (Opcional)
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# Modelo padrão para refinamento de prompts e síntese de pesquisa
# Opções disponíveis: openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Configurações opcionais
# GROQ_MAX_TOKENS=4096
# GROQ_TEMPERATURE=0.7
